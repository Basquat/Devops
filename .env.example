# Environment variables for Flask app connecting to Aiven PostgreSQL
# Copy this file to .env and fill in your actual values from Aiven Terraform outputs
# DO NOT COMMIT .env TO GIT - add .env to your .gitignore

# Database connection details from Aiven Terraform outputs:
# Run: terraform output -json to see all values
# Or individually: terraform output db_host, etc.

DB_HOST=your-db-host-from-aiven-output
DB_PORT=your-db-port-from-aiven-output
DB_NAME=your-db-name-from-aiven-output
DB_USER=your-db-user-from-aiven-output

# Database password - GET THIS FROM AIVEN CONSOLE (not in Terraform output for security)
# In Aiven: Service → Overview → Connection information → Password
DB_PASSWORD=your-actual-password-from-aiven-console

# SSL mode - should be 'require' for Aiven
DB_SSLMODE=require